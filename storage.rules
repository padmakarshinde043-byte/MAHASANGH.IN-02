rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
    }

    match /member-photos/{fileName} {
      allow write: if request.resource != null
        && request.resource.size <= 200 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, delete: if isAdmin();
    }

    match /membership-documents/{fileName} {
      allow write: if false;
      allow read, delete: if isAdmin();
    }

    match /news/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource != null && request.resource.size < 10 * 1024 * 1024;
    }
    match /gallery/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource != null && request.resource.size < 10 * 1024 * 1024;
    }
    match /officers/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource != null && request.resource.size < 10 * 1024 * 1024;
    }

    match /documents/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource != null && request.resource.size < 20 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
